# Non-secret example values only.
namespace            = "CHANGE_ME"
pod_name             = "ga-smoke-pod"
container_name       = "application"
service_account_name = "default"

# Registry path is defined independently from the workload image so the same
# module can be used with Harbor, OpenShift internal registry or another OCI registry.
container_registry = "registry.example.internal/customer-a"
image_repository   = "global-automation/demo-app"
image_tag          = "1.0.0"

# Resulting image reference:
# registry.example.internal/customer-a/global-automation/demo-app:1.0.0

labels = {
  "app.kubernetes.io/managed-by" = "terraform"
  "dn.global-automation/tenant"  = "example"
  "dn.global-automation/env"     = "dev"
}

cpu_request    = "100m"
memory_request = "128Mi"
cpu_limit      = "500m"
memory_limit   = "512Mi"

# Supply these through CI environment variables instead:
# TF_VAR_openshift_api_url
# TF_VAR_openshift_token
# TF_VAR_openshift_ca_certificate
